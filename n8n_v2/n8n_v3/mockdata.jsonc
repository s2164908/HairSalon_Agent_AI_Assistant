    // ========================= 写操作工具（高风险） =========================

    // -------------------------------------------------------------------------
    //  T7. hold_slot — 幂等占位，TTL 10 分钟
    //  何时用：客户选定时段、准备确认前。
    //  【硬约束】必须带 idempotency_key；同 key 重复调用返回同一个 hold。
    // -------------------------------------------------------------------------
    "hold_slot": {
      "success": {
        "input": {
          "customer_id": "cus_1003",
          "stylist_id": "stl_jayden",
          "service_id": "svc_cut_men",
          "start": "2026-09-16T10:00:00+10:00",
          "idempotency_key": "idem_web8f3a_001"
        },
        "output": {
          "ok": true,
          "data": {
            "hold_id": "hold_9001",
            "status": "held",
            "start": "2026-09-16T10:00:00+10:00",
            "end": "2026-09-16T10:30:00+10:00",
            "expires_at": "2026-09-12T09:20:00+10:00",
            "ttl_seconds": 600,
            "quoted_price_aud": 45,
            "replayed": false
          }
        }
      },
      "idempotent_replay": {
        "input": {
          "customer_id": "cus_1003",
          "stylist_id": "stl_jayden",
          "service_id": "svc_cut_men",
          "start": "2026-09-16T10:00:00+10:00",
          "idempotency_key": "idem_web8f3a_001"
        },
        "output": {
          "ok": true,
          "data": {
            "hold_id": "hold_9001",
            "status": "held",
            "expires_at": "2026-09-12T09:20:00+10:00",
            "replayed": true
          },
          "_agent_hint": "replayed = true 表示这是重复调用，不是第二个 hold。不要告诉客户占了两个位。"
        }
      },
      "conflict": {
        "input": {
          "customer_id": "cus_1002",
          "stylist_id": "stl_priya",
          "service_id": "svc_cut_curly",
          "start": "2026-09-16T13:00:00+10:00",
          "idempotency_key": "idem_wa202_007"
        },
        "output": {
          "ok": false,
          "error": {
            "code": "SLOT_TAKEN",
            "message": "该时段已被占用",
            "retryable": false
          },
          "data": {
            "alternatives": [
              { "start": "2026-09-17T09:30:00+10:00", "end": "2026-09-17T11:00:00+10:00" },
              { "start": "2026-09-18T15:00:00+10:00", "end": "2026-09-18T16:30:00+10:00" }
            ]
          },
          "_agent_hint": "并发抢位的正常结果。道歉 + 给替代时段，不要重试同一个槽位。"
        }
      }
    },

    // -------------------------------------------------------------------------
    //  T8. confirm_booking — 把 hold 转成确认预约
    //  何时用：客户明确说"就这个时间"之后。
    //  【硬约束】校验 hold 未过期；金额以本工具返回为准。
    // -------------------------------------------------------------------------
