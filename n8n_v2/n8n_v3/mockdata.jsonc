        },
        "output": {
          "ok": true,
          "data": {
            "candidates": [
              {
                "rank": 1,
                "stylist_id": "stl_amy",
                "stylist_name": "Amy Chen",
                "score": 65,
                "breakdown": { "specialty_match": 40, "texture_experience": 0, "language_match": 15, "price_tier_fit": 10, "availability_in_window": 0 },
