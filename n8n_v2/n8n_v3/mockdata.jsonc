    // -------------------------------------------------------------------------
    //  T4. match_stylist — 发型师匹配（确定性打分）
    //  何时用：客户没指定发型师，或问"谁比较适合我"。
    //  【核心】排序由下面的权重算出，LLM 只负责把 reasons 说成人话，不得改排序。
    // -------------------------------------------------------------------------
    "match_stylist": {
      "_scoring_weights": {
        "specialty_match": 40,
        "texture_experience": 25,
        "language_match": 15,
        "price_tier_fit": 10,
        "availability_in_window": 10,
