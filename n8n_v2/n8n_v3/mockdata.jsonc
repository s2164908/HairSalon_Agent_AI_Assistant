            "ticket_id": "esc_3002",
            "queue": "salon_manager",
            "eta_minutes": 15,
            "customer_message_zh": "很抱歉这次的效果没达到你的预期。我已经把情况转给店长，15 分钟内会有人联系你处理。",
            "agent_must_not": ["承诺退款", "承诺免费重做", "判断责任归属"]
          }
        }
      },
      "price_negotiation": {
        "input": {
          "customer_id": "cus_1003",
