    // -------------------------------------------------------------------------
    //  T10. hair_profile_write — 写发质档案
    //  【硬约束】customer_confirmed 必须为 true 才写；每个字段必须带 source。
    // -------------------------------------------------------------------------
    "hair_profile_write": {
      "success": {
        "input": {
          "customer_id": "cus_1003",
          "fields": {
            "texture": { "value": "wavy", "source": "self_reported" },
            "density": { "value": "medium", "source": "self_reported" },
            "chemical_history": []
          },
          "customer_confirmed": true,
          "confirmed_utterance": "对，微卷，发量中等，没染过"
        },
        "output": {
          "ok": true,
          "data": {
            "profile_id": "hp_1003",
            "customer_id": "cus_1003",
            "written_fields": ["texture", "density", "chemical_history"],
            "confirmed_at": "2026-09-12T09:08:00+10:00",
            "created": true
          }
        }
      },
      "confirmation_required": {
        "input": {
          "customer_id": "cus_1003",
          "fields": { "porosity": { "value": "high", "source": "inferred" } },
          "customer_confirmed": false
        },
        "output": {
          "ok": false,
          "error": {
            "code": "CONFIRMATION_REQUIRED",
            "message": "source = inferred 的字段必须经客户确认后才能写入",
            "retryable": false
          },
          "_agent_hint": "先问客户「你的头发是不是比较吸水、洗完干得快？」，得到确认再写。"
        }
      }
    },

    // -------------------------------------------------------------------------
    //  T11. escalate_to_human — 升级人工
    //  【强制路径】健康问题 / 投诉 / 议价 / 退款 一律走这里，不得自行作答。
    // -------------------------------------------------------------------------
    "escalate_to_human": {
      "health_topic": {
        "input": {
          "customer_id": "cus_1002",
