            "confirmation_sent_to": "web_session_8f3a"
          },
          "_agent_hint": "转达金额时只能用 pricing.total_aud，不得自行计算。"
        }
      },
      "hold_expired": {
        "input": { "hold_id": "hold_8800", "customer_id": "cus_1002", "idempotency_key": "idem_wa202_009" },
        "output": {
          "ok": false,
