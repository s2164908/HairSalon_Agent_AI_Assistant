    {
      "parameters": {
        "resource": "image",
        "operation": "analyze",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o"
        },
        "text": "You are a professional hairstylist's assistant analyzing a customer photo.\n\nFirst judge whether the photo is USABLE for a hairstyle recommendation. A usable photo:\n- shows exactly one person\n- clearly shows the head, face and current hair\n- is reasonably well-lit and in focus\n\nRespond with ONLY a raw JSON object (no markdown, no code fences) in this exact shape:\n{\n  \"is_valid\": true or false,\n  \"reason\": \"short explanation of why the photo is or isn't usable\",\n  \"details\": \"if valid: describe face shape, hair length, hair type/texture, hair color, and any relevant features for styling. If invalid: empty string.\"\n}",
        "inputType": "base64",
        "binaryPropertyName": "photo",
        "options": {
          "detail": "auto",
          "maxTokens": 600
        }
      },
      "id": "afbf8980-39f9-4c2a-ae1a-633ee3eab325",
      "name": "Analyze Photo",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        -2128,
        -64
      ],
      "credentials": {
        "openAiApi": {
          "id": null,
          "name": "Gateway credits",
          "__aiGatewayManaged": true
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Pull the model's text output from whichever field it lands in\nconst raw = $json.content ?? $json.text ?? $json.message?.content ?? JSON.stringify($json);\nlet parsed = { is_valid: false, reason: \"Could not read the analysis result.\", details: \"\" };\ntry {\n  const match = String(raw).match(/\\{[\\s\\S]*\\}/);\n  if (match) {\n    parsed = JSON.parse(match[0]);\n  }\n} catch (e) {\n  parsed = { is_valid: false, reason: \"The analysis could not be parsed.\", details: \"\" };\n}\n// details may come back as an object or a string — normalise to readable text\nlet details = parsed.details;\nif (details && typeof details === \"object\") {\n  details = Object.entries(details)\n    .map(([k, v]) => k.replace(/_/g, \" \") + \": \" + v)\n    .join(\"; \");\n}\nreturn {\n  json: {\n    is_valid: parsed.is_valid === true,\n    reason: parsed.reason || \"\",\n    details: details || \"\",\n  },\n};"
      },
      "id": "24cae07f-3bdb-4ff3-b961-2584db5e4a75",
