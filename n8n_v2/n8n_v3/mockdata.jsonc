  // ===========================================================================
  //  第二部分：工具 I/O 样例（PLAN.md §3 的 11 个工具）
  //  每个工具给 1 个成功样例 + 1-2 个边界/失败样例。
  //  失败样例同时就是 Phase 5 的 adversarial 测试用例。
  // ===========================================================================
  "tool_io": {

    // ========================= 只读工具（低风险） =========================

    // -------------------------------------------------------------------------
    //  T1. service_catalog — 查服务、时长、价格
    //  何时用：客户问项目、价格、要做多久。
    //  不要用在：查优惠（用 get_promotions）。
    // -------------------------------------------------------------------------
    "service_catalog": {
      "success": {
        "input": { "query": "balayage" },
