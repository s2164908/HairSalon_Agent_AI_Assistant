          "date_to": "2026-09-20"
        },
        "output": {
          "ok": true,
          "data": {
            "candidates": [
              {
                "rank": 1,
                "stylist_id": "stl_priya",
                "stylist_name": "Priya Raman",
                "score": 100,
                "breakdown": { "specialty_match": 40, "texture_experience": 25, "language_match": 15, "price_tier_fit": 10, "availability_in_window": 10 },
                "reasons": [
                  "专长包含卷发干剪塑形",
                  "有 curly / coily 发质经验，并持有 DevaCurl Advanced 认证",
