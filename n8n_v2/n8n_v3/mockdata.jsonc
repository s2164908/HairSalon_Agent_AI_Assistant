                "stylist_name": "Marco Ferrari",
                "score": 60,
                "breakdown": { "specialty_match": 0, "texture_experience": 25, "language_match": 15, "price_tier_fit": 10, "availability_in_window": 10 },
                "reasons": [
                  "有 curly 发质经验，但专长不含卷发干剪",
                  "可用英语沟通",
                  "所选日期区间内有可用时段"
                ]
              }
            ],
            "excluded": [
              { "stylist_id": "stl_sofia", "reason": "休假中（产假至 2026-11-30）" },
              { "stylist_id": "stl_amy", "reason": "无 curly 发质经验" },
              { "stylist_id": "stl_jayden", "reason": "junior 级别不可执行 svc_cut_curly" }
            ],
            "returned": 2,
