        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"customer_name\": {\n      \"type\": \"string\",\n      \"description\": \"Customer's full name, or empty string if not provided yet\"\n    },\n    \"email\": {\n      \"type\": \"string\",\n      \"description\": \"Customer's email address, or empty string if not provided yet\"\n    },\n    \"phone\": {\n      \"type\": \"string\",\n      \"description\": \"Customer's phone number, or empty string if not provided yet\"\n    },\n    \"service\": {\n      \"type\": \"string\",\n      \"description\": \"Requested barbershop service (e.g. Haircut, Beard Trim, Hair Coloring), or empty string if not provided yet\"\n    },\n    \"preferred_date\": {\n      \"type\": \"string\",\n      \"description\": \"Preferred appointment date in YYYY-MM-DD format, or empty string if not provided yet\"\n    },\n    \"preferred_time\": {\n      \"type\": \"string\",\n      \"description\": \"Preferred appointment time in HH:mm 24-hour format, or empty string if not provided yet\"\n    },\n    \"reply\": {\n      \"type\": \"string\",\n      \"description\": \"The natural-language message to show the customer\"\n    }\n  },\n  \"required\": [\n    \"customer_name\",\n    \"email\",\n    \"phone\",\n    \"service\",\n    \"preferred_date\",\n    \"preferred_time\",\n    \"reply\"\n  ]\n}"
      },
